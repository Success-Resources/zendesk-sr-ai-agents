ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
ZENDESK_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_KNOWLEDGE_REPO=Success-Resources/zendesk-sr-ai-agents
GITHUB_KNOWLEDGE_BRANCH=main
KNOWLEDGE_TTL_SECONDS=600

# matcher = paste GitHub email (fine on Vercel Hobby)
# claude  = remote agents (Anthropic API). Use this in production. Not your laptop.
# ollama  = local test only
AGENT_BACKEND=claude
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

GOOGLE_SHEET_MMI=1I0_drElvOqO4RLeAC-cBjXr6ekXQ_OAGbRigwOyjYCE
# Quinn live calendar: NWA / GBI / TTT / EWC dates, cities, F&A. Share as Viewer anyone-with-link.
GOOGLE_SHEET_QL=12z82ByWdS-_wJxPWlrN2F4TNZ2Cq92Dm1bbA_hIKimE
GOOGLE_SHEET_RAFA=1_nudcBpyJZiUkKKeufXWpwfsbBVOT4XpxHNX-fmbC-E
GOOGLE_SHEET_ALLOCATION=
GOOGLE_SHEET_REGISTRATIONS=
# Optional extra MMI Full List sheets as JSON. Stockholm + Rotterdam live in agents/event-sheets.json.
# [{"city":"Madrid","code":"MMI2609MAD","aliases":["madrid"],"sheet_id":"...","tab":"Full List","gid":""}]
GOOGLE_SHEET_MMI_EVENTS=
GOOGLE_DOC_IDS=

# ActiveCampaign — Maya confirmation actions. Get the URL + key from AC Settings → Developer.
# If the email is on the city Full List, Maya adds MMIYYMMCCC-Standard or -VIP.
# If that tag is already on the contact, she removes it and adds it again so the automation fires.
# AGENT_ACTIONS=off disables writes. propose and execute both apply confirmation tags
# and unsubscribe the ticket sender from every ActiveCampaign list when they ask.
ACTIVECAMPAIGN_URL=
ACTIVECAMPAIGN_API_TOKEN=
AGENT_ACTIONS=execute

# Testing. Only these requester emails get a public reply and status Solved.
# Every other ticket gets a private internal note, and the agent does not change the status.
# Leave empty to disable public replies entirely.
ZENDESK_PUBLIC_SOLVE_EMAILS=akram.r@srglobal.com
# Quinn and Rafa only. Maya does not use this address.
# MMI tickets Maya cannot answer go to ZENDESK_MMI_ASSIGNEE_EMAIL.
# Tickets received at mmo@srglobal.com that Maya cannot answer go to ZENDESK_MMO_ASSIGNEE_EMAIL.
# Mail received at srv@srglobal.com is left untouched.
ZENDESK_HUMAN_ASSIGNEE_EMAIL=
ZENDESK_MMI_ASSIGNEE_EMAIL=meda.c@srglobal.com
ZENDESK_MMO_ASSIGNEE_EMAIL=alina.last@srglobal.com
AC_MMI_TAG=MMI
AC_MMI_AUTOMATION_ID=
AC_MMI_RESEND_AUTOMATION_ID=
